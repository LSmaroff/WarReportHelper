            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="SaveEditButton" Grid.Column="1" Content="Save" Height="36" Margin="0,0,8,0"/>
                <Button x:Name="CancelEditButton" Grid.Column="2" Content="Cancel" Height="36"/>
            </Grid>
        </Grid>
    </Border>
</Window>
"@

    $editWindow = Read-Xaml $editXaml
    $editWindow.Owner = $script:MainWindow

    $EditRoot = $editWindow.FindName("EditRoot")
    $EditLabel = $editWindow.FindName("EditLabel")
    $EditInputBorder = $editWindow.FindName("EditInputBorder")
    $EditTaskBox = $editWindow.FindName("EditTaskBox")
    $SaveEditButton = $editWindow.FindName("SaveEditButton")
    $CancelEditButton = $editWindow.FindName("CancelEditButton")

    $EditRoot.Background = New-Brush $script:S["WindowBackgroundColor"]
    $editWindow.Background = New-Brush $script:S["WindowBackgroundColor"]
    $EditLabel.Foreground = New-Brush $script:S["SectionLabelFontColor"]
    $EditInputBorder.Background = New-Brush $script:S["InputBackgroundColor"]
    $EditTaskBox.Foreground = New-Brush $script:S["InputFontColor"]
    $EditTaskBox.FontSize = $script:S["InputFontSize"]

    foreach ($button in @($SaveEditButton, $CancelEditButton)) {
        $button.Foreground = New-Brush $script:S["ButtonFontColor"]
        $button.Background = New-Brush $script:S["ButtonBackgroundColor"]
        $button.BorderBrush = New-Brush "#FF000000"
        $button.BorderThickness = [System.Windows.Thickness]::new(1)
        $button.FontWeight = [System.Windows.FontWeights]::SemiBold
    }

    $cleanOriginal = [string]$OriginalTask
    if ($cleanOriginal.StartsWith("• ")) {
        $cleanOriginal = $cleanOriginal.Substring(2)
    }
    elseif ($cleanOriginal.StartsWith("•")) {
        $cleanOriginal = $cleanOriginal.Substring(1).Trim()
    }

    $EditTaskBox.Text = $cleanOriginal
    $EditTaskBox.SelectAll()
    $EditTaskBox.Focus() | Out-Null

    $result = @{
        Saved = $false
        Text = $OriginalTask
    }

    $SaveEditButton.Add_Click({
        $newText = Normalize-TaskText $EditTaskBox.Text

        if (-not [string]::IsNullOrWhiteSpace($newText)) {
            $result.Saved = $true
            $result.Text = $newText
            $editWindow.Close()
        }
    })

    $CancelEditButton.Add_Click({
        $editWindow.Close()
    })

    $EditTaskBox.Add_PreviewKeyDown({
        param($sender, $e)

        $ctrlDown = (
            [System.Windows.Input.Keyboard]::Modifiers -band
            [System.Windows.Input.ModifierKeys]::Control
        ) -eq [System.Windows.Input.ModifierKeys]::Control

        if ($e.Key -eq [System.Windows.Input.Key]::Return -and $ctrlDown) {
            $e.Handled = $true
            $newText = Normalize-TaskText $EditTaskBox.Text

            if (-not [string]::IsNullOrWhiteSpace($newText)) {
                $result.Saved = $true
                $result.Text = $newText
                $editWindow.Close()
            }
        }
    })

    [void]$editWindow.ShowDialog()
    return $result
}

function Set-DadJokeText {
    param([string]$JokeText)

    if ([string]::IsNullOrWhiteSpace($JokeText)) {
        $JokeText = $script:DadJokeFallback
    }

    $script:DadJokeDisplayText = "Dad joke: $JokeText"

    try {
        if ($null -ne $script:JokeBlockControl) {
            if ($script:JokeBlockControl.Dispatcher.CheckAccess()) {
                $script:JokeBlockControl.Text = $script:DadJokeDisplayText
            }
            else {
                [void]$script:JokeBlockControl.Dispatcher.BeginInvoke([Action]{
                    if ($null -ne $script:JokeBlockControl) {
                        $script:JokeBlockControl.Text = $script:DadJokeDisplayText
                    }
                })
            }
        }
    }
    catch {}
}

function Start-DadJokeLoad {
    if ($null -eq $script:JokeBlockControl) {
        return
    }

    Set-DadJokeText $script:DadJokeFallback

    try {
        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
    }
    catch {}

    try {
        if ($null -ne $script:DadJokeWebClient) {
            try { $script:DadJokeWebClient.CancelAsync() } catch {}
            try { $script:DadJokeWebClient.Dispose() } catch {}
        }

        $client = New-Object System.Net.WebClient
        $client.Headers.Add("Accept", "text/plain")
        $client.Headers.Add("User-Agent", "WarReportHelper Task Tracker")
        $script:DadJokeWebClient = $client

        $client.add_DownloadStringCompleted({
            param($sender, $eventArgs)

            $finalJoke = $script:DadJokeFallback

            try {
                if (-not $eventArgs.Cancelled -and $null -eq $eventArgs.Error) {
                    $apiText = ([string]$eventArgs.Result).Trim()

                    if (-not [string]::IsNullOrWhiteSpace($apiText)) {
                        $finalJoke = $apiText
                    }
                }
            }
            catch {
                $finalJoke = $script:DadJokeFallback
            }

            Set-DadJokeText $finalJoke

            try { $sender.Dispose() } catch {}
        })

        $client.DownloadStringAsync([Uri]"https://icanhazdadjoke.com/")
    }
    catch {
        Set-DadJokeText $script:DadJokeFallback
    }
}

