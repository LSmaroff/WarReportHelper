function Set-ButtonDisplay {
    param(
        [System.Windows.Controls.Button]$Button,
        [string]$Text,
        [string]$IconPath,
        [double]$TextWidth = [double]::NaN,
        [double]$TextHeight = [double]::NaN,
        [string]$TextHorizontalAlignment = "Stretch",
        [string]$IconHorizontalAlignment = "Center",
        [double]$MaxIconSize = 28
    )

    if ($false -and $script:S["UseButtonIcons"] -and $IconPath -and (Test-Path $IconPath)) {
        $image = New-ButtonImage -Path $IconPath -MaxSize $MaxIconSize

        if ($null -ne $image) {
            $Button.Content = $image
            $Button.Padding = [System.Windows.Thickness]::new(0)
            $Button.Background = [System.Windows.Media.Brushes]::Transparent
            $Button.BorderBrush = [System.Windows.Media.Brushes]::Transparent
            $Button.BorderThickness = [System.Windows.Thickness]::new(0)
            $Button.Width = $image.Width + 12
            $Button.Height = $image.Height + 12
            $Button.MinWidth = 0
            $Button.MinHeight = 0
            $Button.HorizontalAlignment = [System.Enum]::Parse([System.Windows.HorizontalAlignment], $IconHorizontalAlignment)
            return
        }
    }

    Set-WpfButtonStyle $Button
    $Button.Content = $Text
    $Button.Padding = [System.Windows.Thickness]::new(12, 8, 12, 8)
    $Button.MinWidth = 0
    $Button.MinHeight = 0
    $Button.HorizontalAlignment = [System.Enum]::Parse([System.Windows.HorizontalAlignment], $TextHorizontalAlignment)

    if ([double]::IsNaN($TextWidth)) {
        $Button.Width = [double]::NaN
    }
    else {
        $Button.Width = $TextWidth
    }

    if ([double]::IsNaN($TextHeight)) {
        $Button.Height = [double]::NaN
    }
    else {
        $Button.Height = $TextHeight
    }
