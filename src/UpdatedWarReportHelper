# -----------------------------
# Animated Options Popup
# -----------------------------
function Show-SettingsPopup {
    if ($SettingsPopup.IsOpen) {
        $SettingsPopup.IsOpen = $false
        return
    }

    $SettingsPopup.PlacementTarget = $SettingsButton
    $SettingsPopupBorder.Opacity = 0

    if ($SettingsPopupBorder.RenderTransform -is [System.Windows.Media.ScaleTransform]) {
        $SettingsPopupBorder.RenderTransform.ScaleX = 0.96
        $SettingsPopupBorder.RenderTransform.ScaleY = 0.75
    }

    $SettingsPopup.IsOpen = $true

    $duration = New-Object System.Windows.Duration ([TimeSpan]::FromMilliseconds(170))

    $ease = New-Object System.Windows.Media.Animation.CubicEase
    $ease.EasingMode = [System.Windows.Media.Animation.EasingMode]::EaseOut

    $opacityAnimation = New-Object System.Windows.Media.Animation.DoubleAnimation
    $opacityAnimation.From = 0
    $opacityAnimation.To = 1
    $opacityAnimation.Duration = $duration
    $opacityAnimation.EasingFunction = $ease

    $scaleXAnimation = New-Object System.Windows.Media.Animation.DoubleAnimation
    $scaleXAnimation.From = 0.96
    $scaleXAnimation.To = 1
    $scaleXAnimation.Duration = $duration
    $scaleXAnimation.EasingFunction = $ease

    $scaleYAnimation = New-Object System.Windows.Media.Animation.DoubleAnimation
    $scaleYAnimation.From = 0.75
    $scaleYAnimation.To = 1
    $scaleYAnimation.Duration = $duration
    $scaleYAnimation.EasingFunction = $ease

    $SettingsPopupBorder.BeginAnimation(
        [System.Windows.UIElement]::OpacityProperty,
        $opacityAnimation
    )

    $SettingsPopupBorder.RenderTransform.BeginAnimation(
        [System.Windows.Media.ScaleTransform]::ScaleXProperty,
        $scaleXAnimation
    )

    $SettingsPopupBorder.RenderTransform.BeginAnimation(
        [System.Windows.Media.ScaleTransform]::ScaleYProperty,
        $scaleYAnimation
    )
}

