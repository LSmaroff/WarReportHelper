}

function Confirm-HexColor {
    param(
        [object]$Value,
        [string]$Fallback
    )

    try {
        if ($null -ne $Value -and [string]$Value -ne "") {
            [void][System.Windows.Media.ColorConverter]::ConvertFromString([string]$Value)
            return [string]$Value
        }
    }
    catch {}

    return $Fallback
}

function New-Brush {
    param([string]$HexColor)

    if ([string]::IsNullOrWhiteSpace($HexColor)) {
        $HexColor = "#FFFFFFFF"
    }

    if ($script:BrushCache.Contains($HexColor)) {
        return $script:BrushCache[$HexColor]
    }

    try {
        $color = [System.Windows.Media.ColorConverter]::ConvertFromString($HexColor)
    }
    catch {
        $HexColor = "#FFFFFFFF"

        if ($script:BrushCache.Contains($HexColor)) {
            return $script:BrushCache[$HexColor]
        }

        $color = [System.Windows.Media.ColorConverter]::ConvertFromString($HexColor)
    }

    $brush = [System.Windows.Media.SolidColorBrush]::new($color)

    if ($brush.CanFreeze) {
        $brush.Freeze()
    }

    $script:BrushCache[$HexColor] = $brush
    return $brush
}

function Darken-HexColor {
    param(
        [string]$HexColor,
        [int]$Amount = 10
    )

    try {
        $color = [System.Windows.Media.ColorConverter]::ConvertFromString($HexColor)

        $r = [Math]::Max(0, [int]$color.R - $Amount)
        $g = [Math]::Max(0, [int]$color.G - $Amount)
        $b = [Math]::Max(0, [int]$color.B - $Amount)

        return "#{0:X2}{1:X2}{2:X2}{3:X2}" -f $color.A, $r, $g, $b
    }
    catch {
        return "#FFE5E7EB"
    }
}

function Convert-WpfHexToDrawingColor {
    param([string]$HexColor)

    try {
        $color = [System.Windows.Media.ColorConverter]::ConvertFromString($HexColor)
        return [System.Drawing.Color]::FromArgb($color.A, $color.R, $color.G, $color.B)
    }
    catch {
        return [System.Drawing.Color]::White
    }
}

function Convert-DrawingColorToWpfHex {
    param([System.Drawing.Color]$Color)

    return "#{0:X2}{1:X2}{2:X2}{3:X2}" -f $Color.A, $Color.R, $Color.G, $Color.B
}

function Select-Color {
    param([string]$CurrentHex)

    $colorDialog = New-Object System.Windows.Forms.ColorDialog
    $colorDialog.FullOpen = $true
    $colorDialog.Color = Convert-WpfHexToDrawingColor $CurrentHex

    if ($colorDialog.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
        return Convert-DrawingColorToWpfHex $colorDialog.Color
    }

    return $CurrentHex
}

function Select-IconPath {
    param([string]$CurrentPath)

    $dialog = New-Object Microsoft.Win32.OpenFileDialog
    $dialog.Filter = "Image Files (*.png;*.ico;*.jpg;*.jpeg;*.bmp;*.gif)|*.png;*.ico;*.jpg;*.jpeg;*.bmp;*.gif|All Files (*.*)|*.*"
    $dialog.Title = "Select Button Icon"

    if ($CurrentPath -and (Test-Path $CurrentPath)) {
        $dialog.InitialDirectory = Split-Path -Parent $CurrentPath
        $dialog.FileName = Split-Path -Leaf $CurrentPath
    }

    if ($dialog.ShowDialog() -eq $true) {
        return $dialog.FileName
    }

    return $CurrentPath
}

function Select-FolderPath {
    param([string]$CurrentPath)

    $dialog = New-Object System.Windows.Forms.FolderBrowserDialog
    $dialog.Description = "Select the folder where automatic task list exports should be saved."
    $dialog.ShowNewFolderButton = $true

    if ($CurrentPath -and (Test-Path $CurrentPath)) {
        $dialog.SelectedPath = $CurrentPath
    }
    else {
        $dialog.SelectedPath = $script:ScriptDirectory
    }

    if ($dialog.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
        return $dialog.SelectedPath
    }

    return $CurrentPath
}

function Select-SaveFilePath {
    param(
        [string]$InitialDirectory,
        [string]$DefaultFileName
    )

    $dialog = New-Object Microsoft.Win32.SaveFileDialog
    $dialog.Title = "Save Task List"
    $dialog.Filter = "Text Files (*.txt)|*.txt|All Files (*.*)|*.*"
    $dialog.FileName = $DefaultFileName
    $dialog.OverwritePrompt = $true
    $dialog.AddExtension = $true
    $dialog.DefaultExt = ".txt"

    if ($InitialDirectory -and (Test-Path $InitialDirectory)) {
        $dialog.InitialDirectory = $InitialDirectory
    }
    else {
        $dialog.InitialDirectory = $script:ScriptDirectory
    }

    if ($dialog.ShowDialog() -eq $true) {
        return $dialog.FileName
    }

    return $null
}

function Get-ExportDirectory {
    try {
        if ([string]::IsNullOrWhiteSpace($script:S["ExportDirectory"])) {
            $script:S["ExportDirectory"] = $script:ScriptDirectory
        }

        if (-not (Test-Path $script:S["ExportDirectory"])) {
            [void](New-Item -ItemType Directory -Path $script:S["ExportDirectory"] -Force)
        }

        return $script:S["ExportDirectory"]
    }
    catch {
        return $script:ScriptDirectory
    }
}

function Get-ClampedInt {
    param(
        [string]$Text,
        [int]$Fallback,
        [int]$Minimum,
        [int]$Maximum
    )

    $value = 0

    if ([int]::TryParse($Text, [ref]$value)) {
        if ($value -lt $Minimum) { return $Minimum }
        if ($value -gt $Maximum) { return $Maximum }
        return $value
    }

    return $Fallback
}

function Read-Xaml {
    param([string]$Xaml)

    $xml = [xml]$Xaml
    $reader = New-Object System.Xml.XmlNodeReader $xml
    return [Windows.Markup.XamlReader]::Load($reader)
}

function Get-CurrentTasks {
    $tasks = @()

    if ($null -ne $script:TaskListControl) {
        foreach ($item in $script:TaskListControl.Items) {
            $tasks += [string]$item
        }
    }
    else {
        $tasks = @($script:SavedTasks)
    }

    return $tasks
}

function Load-Config {
    if (-not (Test-Path $script:ConfigFile)) {
        return
    }

    try {
        $config = Get-Content $script:ConfigFile -Raw | ConvertFrom-Json
        $properties = @($config.PSObject.Properties.Name)

        foreach ($key in @($script:S.Keys)) {
            if ($properties -contains $key) {
                if ($key -like "*Color") {
                    $script:S[$key] = Confirm-HexColor $config.$key $script:S[$key]
                }
                elseif ($key -in @("UseButtonIcons", "AutoSaveEnabled", "ListVisible", "DynamicListFontSizing", "CheckForUpdatesOnStartup")) {
                    $script:S[$key] = [bool]$config.$key
                }
                elseif ($key -in @("TitleFontSize", "SubtitleFontSize", "SectionLabelFontSize", "ListFontSize", "InputFontSize", "AutoSaveIntervalMinutes")) {
                    $script:S[$key] = [int]$config.$key
                }
                elseif ($key -in @("WindowWidth", "WindowHeight")) {
                    $script:S[$key] = [double]$config.$key
                }
                else {
                    $script:S[$key] = [string]$config.$key
                }
            }
        }

        if ([string]::IsNullOrWhiteSpace($script:S["ExportDirectory"])) {
            $script:S["ExportDirectory"] = $script:ScriptDirectory
        }

        $script:S["AutoSaveIntervalMinutes"] = Get-ClampedInt ([string]$script:S["AutoSaveIntervalMinutes"]) 60 1 1440

        if ($properties -contains "Tasks") {
            $script:SavedTasks = @($config.Tasks | ForEach-Object { [string]$_ })
        }

        if ($properties -contains "CustomThemes") {
            $script:CustomThemes = [ordered]@{}
            foreach ($themeProperty in $config.CustomThemes.PSObject.Properties) {
                $themeSettings = [ordered]@{}
                foreach ($settingProperty in $themeProperty.Value.PSObject.Properties) {
                    $themeSettings[$settingProperty.Name] = [string]$settingProperty.Value
                }
                $script:CustomThemes[$themeProperty.Name] = $themeSettings
            }
        }
    }
    catch {
        Show-AppMessage `
            -Message "The configuration file could not be loaded. Default settings will be used." `
            -Title "Config Load Error" `
            -Image ([System.Windows.MessageBoxImage]::Warning)
    }
}

function Save-Config {
    try {
        if ($null -ne $script:MainWindow) {
            if ($script:MainWindow.ActualWidth -gt 0) {
                $script:S["WindowWidth"] = $script:MainWindow.ActualWidth
            }

            if ($script:MainWindow.ActualHeight -gt 0) {
                $script:S["WindowHeight"] = $script:MainWindow.ActualHeight
            }
        }

        $config = [ordered]@{}

        foreach ($key in @($script:S.Keys)) {
            $config[$key] = $script:S[$key]
        }

        if ($script:IsViewingPreviousList) {
            $config["Tasks"] = @($script:CurrentDayTasksCache)
        }
        else {
            $config["Tasks"] = @(Get-CurrentTasks)
        }
        $config["CustomThemes"] = $script:CustomThemes

        $config | ConvertTo-Json -Depth 10 | Set-Content -Path $script:ConfigFile -Encoding UTF8
    }
    catch {}
}

