function Update-DynamicListFontSizing {
    if ($null -eq $TaskList -or $null -eq $ListCard -or $null -eq $script:MainWindow) {
        return
    }

    if (-not [bool]$script:S["DynamicListFontSizing"]) {
        $TaskList.FontSize = [double]$script:S["ListFontSize"]
        $script:MainWindow.Resources["ListItemPadding"] = [System.Windows.Thickness]::new(12, 9, 12, 9)
        $script:MainWindow.Resources["ListItemMargin"] = [System.Windows.Thickness]::new(0, 2, 0, 2)
        return
    }

    $baseFontSize = [double]$script:S["ListFontSize"]
    $taskCount = [Math]::Max(1, [int]$TaskList.Items.Count)
    $availableHeight = [double]$ListCard.ActualHeight

    if ($availableHeight -lt 120) {
        $availableHeight = [Math]::Max(120, [double]$script:MainWindow.ActualHeight * 0.42)
    }

    $usableHeight = [Math]::Max(100, $availableHeight - 22)
    $targetVisibleRows = [Math]::Min([Math]::Max($taskCount, 8), 18)
    $rowHeight = $usableHeight / $targetVisibleRows

    $dynamicFontSize = [Math]::Floor($rowHeight * 0.58)
    $dynamicFontSize = [Math]::Max(9, [Math]::Min($baseFontSize, $dynamicFontSize))

    if ($taskCount -le 8) {
        $dynamicFontSize = [Math]::Max([Math]::Min($baseFontSize, 13), $dynamicFontSize)
    }

    $verticalPadding = [Math]::Floor(($rowHeight - $dynamicFontSize - 7) / 2)
    $verticalPadding = [Math]::Max(2, [Math]::Min(9, $verticalPadding))
    $horizontalPadding = [Math]::Max(8, [Math]::Min(12, [Math]::Floor($verticalPadding + 6)))
    $marginY = [Math]::Max(0, [Math]::Min(2, [Math]::Floor($verticalPadding / 3)))

    $TaskList.FontSize = [double]$dynamicFontSize
    $script:MainWindow.Resources["ListItemPadding"] = [System.Windows.Thickness]::new($horizontalPadding, $verticalPadding, $horizontalPadding, $verticalPadding)
    $script:MainWindow.Resources["ListItemMargin"] = [System.Windows.Thickness]::new(0, $marginY, 0, $marginY)
}

