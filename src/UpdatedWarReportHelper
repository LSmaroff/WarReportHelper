function Apply-ThemeDataToMap {
    param(
        [System.Collections.IDictionary]$Target,
        [System.Collections.IDictionary]$ThemeData
    )

    foreach ($key in (Get-ThemeColorKeys)) {
        if ($ThemeData.Contains($key)) {
            $Target[$key] = Confirm-HexColor $ThemeData[$key] $Target[$key]
        }
    }
}

function Apply-AccentToMap {
    param(
        [System.Collections.IDictionary]$Target,
        [string]$AccentColor
    )

    $accent = Confirm-HexColor $AccentColor $Target["AccentColor"]
    $Target["AccentColor"] = $accent
    $Target["ButtonBackgroundColor"] = $accent
    $Target["WindowBorderColor"] = $accent
    $Target["TitleOutlineColor"] = $accent
    $Target["EditButtonBackgroundColor"] = $accent
    $Target["ListHoverColor"] = $accent
    $Target["StatusBackgroundColor"] = $accent
}

function Apply-MainTextColorToMap {
    param(
        [System.Collections.IDictionary]$Target,
        [string]$TextColor
    )

    $text = Confirm-HexColor $TextColor $Target["TitleFontColor"]
    foreach ($key in @("TitleFontColor", "SubtitleFontColor", "SectionLabelFontColor", "ListFontColor", "InputFontColor", "ListHoverTextColor", "SettingsMenuTextColor", "StatusTextColor")) {
        $Target[$key] = $text
    }
}

function Get-ThemeObjectFromMap {
    param(
        [System.Collections.IDictionary]$Source,
        [string]$Name = "Custom Theme"
    )

    $settings = [ordered]@{}
    foreach ($key in (Get-ThemeColorKeys)) {
        $settings[$key] = [string]$Source[$key]
    }

    return [ordered]@{
        Version = 1
        Name = $Name
        Settings = $settings
    }
}

function Convert-ThemeObjectToString {
    param([object]$ThemeObject)

    $json = $ThemeObject | ConvertTo-Json -Depth 8 -Compress
    $bytes = [System.Text.Encoding]::UTF8.GetBytes($json)
    return "WARHELPER_THEME_V1:" + [Convert]::ToBase64String($bytes)
}

function Convert-ThemeStringToObject {
    param([string]$ThemeString)

    if ([string]::IsNullOrWhiteSpace($ThemeString)) {
        throw "Theme string is empty."
    }

    $raw = $ThemeString.Trim()
    if ($raw.StartsWith("WARHELPER_THEME_V1:")) {
        $raw = $raw.Substring("WARHELPER_THEME_V1:".Length)
    }

    $json = [System.Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($raw))
    return $json | ConvertFrom-Json
}

function Convert-ThemeSettingsToHashtable {
    param([object]$SettingsObject)

    $themeSettings = [ordered]@{}
    foreach ($property in $SettingsObject.PSObject.Properties) {
        $themeSettings[$property.Name] = [string]$property.Value
    }
    return $themeSettings
}

