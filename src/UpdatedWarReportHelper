            <Setter Property="BorderBrush" Value="#FFCBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#FF1E293B"/>
            <Setter Property="Background" Value="#FFE5E7EB"/>
            <Setter Property="BorderBrush" Value="#FFCBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>

        <Style TargetType="{x:Type Expander}">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="SettingsPanel" Margin="18"/>
    </ScrollViewer>
</Window>
"@

    $settingsWindow = Read-Xaml $settingsXaml
    $settingsWindow.Owner = $script:MainWindow
    $settingsPanel = $settingsWindow.FindName("SettingsPanel")

    $temp = @{}
    foreach ($key in @($script:S.Keys)) {
        $temp[$key] = $script:S[$key]
    }

    $builtInThemes = Get-BuiltInThemes
    $settingsButtons = New-Object System.Collections.ArrayList
    $sizeBoxes = @{}
    $colorPreviews = New-Object System.Collections.ArrayList
    $comboBoxes = New-Object System.Collections.ArrayList
    $textBoxes = New-Object System.Collections.ArrayList
    $previewControls = @{}

    function New-SettingsButton {
        param([string]$Text)

        $button = New-Object System.Windows.Controls.Button
        $button.Content = $Text
        $button.Height = 34
        $button.Margin = [System.Windows.Thickness]::new(4)
        $button.Style = $settingsWindow.Resources["ModernButton"]
        Register-ButtonPressAnimation $button
        [void]$settingsButtons.Add($button)
        return $button
    }

    function New-SettingsTextBox {
        param([string]$Text = "")

        $box = New-Object System.Windows.Controls.TextBox
        $box.Text = $Text
        $box.Style = $settingsWindow.Resources["ModernTextBox"]
        $box.VerticalContentAlignment = "Center"
        [void]$textBoxes.Add($box)
        return $box
    }

    function Add-Section {
        param(
            [string]$Name,
            [bool]$Expanded = $true
        )

        $expander = New-Object System.Windows.Controls.Expander
        $expander.Tag = $Name
        $expander.IsExpanded = $Expanded

        if ($Expanded) { $expander.Header = "- $Name" } else { $expander.Header = "+ $Name" }
        $expander.Add_Expanded({ $this.Header = "- $($this.Tag)" })
        $expander.Add_Collapsed({ $this.Header = "+ $($this.Tag)" })

        $border = New-Object System.Windows.Controls.Border
        $border.BorderBrush = New-Brush "#FFCBD5E1"
        $border.BorderThickness = [System.Windows.Thickness]::new(1)
        $border.CornerRadius = [System.Windows.CornerRadius]::new(12)
        $border.Padding = [System.Windows.Thickness]::new(12)
        $border.Margin = [System.Windows.Thickness]::new(0, 8, 0, 0)
        $border.Background = New-Brush "#11FFFFFF"

        $stack = New-Object System.Windows.Controls.StackPanel
        $border.Child = $stack
        $expander.Content = $border
        [void]$settingsPanel.Children.Add($expander)
        return $stack
    }

    function New-Label {
        param([string]$Text)
        $label = New-Object System.Windows.Controls.TextBlock
        $label.Text = $Text
        $label.VerticalAlignment = "Center"
        return $label
    }

    function Add-TwoColumnRow {
        param(
            [System.Windows.Controls.StackPanel]$Parent,
            [string]$Label,
            [System.Windows.UIElement]$Control
        )

        $grid = New-Object System.Windows.Controls.Grid
        $grid.Margin = [System.Windows.Thickness]::new(0, 0, 0, 8)

        $col1 = New-Object System.Windows.Controls.ColumnDefinition
        $col1.Width = [System.Windows.GridLength]::new(1, [System.Windows.GridUnitType]::Star)
        [void]$grid.ColumnDefinitions.Add($col1)

        $col2 = New-Object System.Windows.Controls.ColumnDefinition
        $col2.Width = [System.Windows.GridLength]::new(220)
        [void]$grid.ColumnDefinitions.Add($col2)

        $labelBlock = New-Label $Label
        [System.Windows.Controls.Grid]::SetColumn($labelBlock, 0)
        [void]$grid.Children.Add($labelBlock)

        [System.Windows.Controls.Grid]::SetColumn($Control, 1)
        [void]$grid.Children.Add($Control)

        [void]$Parent.Children.Add($grid)
    }

    function Add-SizeRow {
        param(
            [System.Windows.Controls.StackPanel]$Parent,
            [string]$Key,
            [string]$Label
        )

        $grid = New-Object System.Windows.Controls.Grid
        $grid.Margin = [System.Windows.Thickness]::new(0, 0, 0, 6)

        foreach ($width in @("*", "38", "90", "38")) {
            $column = New-Object System.Windows.Controls.ColumnDefinition
            if ($width -eq "*") {
                $column.Width = [System.Windows.GridLength]::new(1, [System.Windows.GridUnitType]::Star)
            }
            else {
                $column.Width = [System.Windows.GridLength]::new([double]$width)
            }
            [void]$grid.ColumnDefinitions.Add($column)
        }

        $labelBlock = New-Label $Label
        [System.Windows.Controls.Grid]::SetColumn($labelBlock, 0)
        [void]$grid.Children.Add($labelBlock)

        $minus = New-SettingsButton "-"
        [System.Windows.Controls.Grid]::SetColumn($minus, 1)
        [void]$grid.Children.Add($minus)

        $box = New-SettingsTextBox ([string]$temp[$Key])
        $box.TextAlignment = "Center"
        [System.Windows.Controls.Grid]::SetColumn($box, 2)
        [void]$grid.Children.Add($box)

        $plus = New-SettingsButton "+"
        [System.Windows.Controls.Grid]::SetColumn($plus, 3)
        [void]$grid.Children.Add($plus)

        $minus.Tag = @{ Box = $box; Change = -1 }
        $plus.Tag = @{ Box = $box; Change = 1 }

        $adjustHandler = {
            $tagData = $this.Tag
            $targetBox = $tagData.Box
            $changeValue = [int]$tagData.Change
            $current = Get-ClampedInt $targetBox.Text 14 8 72
            $newValue = $current + $changeValue
            if ($newValue -lt 8) { $newValue = 8 }
            if ($newValue -gt 72) { $newValue = 72 }
            $targetBox.Text = [string]$newValue
        }

        $minus.Add_Click($adjustHandler)
        $plus.Add_Click($adjustHandler)
        $sizeBoxes[$Key] = $box
        [void]$Parent.Children.Add($grid)
    }

    function Add-ColorRow {
        param(
            [System.Windows.Controls.StackPanel]$Parent,
            [string]$Key,
            [string]$Label
        )

        $dock = New-Object System.Windows.Controls.DockPanel
        $dock.Margin = [System.Windows.Thickness]::new(0, 0, 0, 8)
        $dock.LastChildFill = $true

        $preview = New-Object System.Windows.Controls.Border
        $preview.Width = 28
        $preview.Height = 24
        $preview.BorderBrush = New-Brush "#FF000000"
        $preview.BorderThickness = [System.Windows.Thickness]::new(1)
        $preview.Background = New-Brush $temp[$Key]
        $preview.Margin = [System.Windows.Thickness]::new(6, 0, 0, 0)
        [System.Windows.Controls.DockPanel]::SetDock($preview, [System.Windows.Controls.Dock]::Right)

        $button = New-SettingsButton "Choose"
        $button.Width = 90
        $button.Margin = [System.Windows.Thickness]::new(0, 0, 6, 0)
        $button.Tag = $Key
        [System.Windows.Controls.DockPanel]::SetDock($button, [System.Windows.Controls.Dock]::Right)

        $labelBlock = New-Label $Label
        [void]$dock.Children.Add($preview)
        [void]$dock.Children.Add($button)
        [void]$dock.Children.Add($labelBlock)
        [void]$colorPreviews.Add(@{ Key = $Key; Preview = $preview })

        $button.Add_Click({
            $colorKey = [string]$this.Tag
            $temp[$colorKey] = Select-Color $temp[$colorKey]
            Apply-SettingsWindowVisuals
        })

        [void]$Parent.Children.Add($dock)
    }

    function Add-ActionColorRow {
        param(
            [System.Windows.Controls.StackPanel]$Parent,
            [string]$Label,
            [string]$CurrentKey,
            [string]$Mode
        )

        $dock = New-Object System.Windows.Controls.DockPanel
        $dock.Margin = [System.Windows.Thickness]::new(0, 0, 0, 8)
        $dock.LastChildFill = $true

        $preview = New-Object System.Windows.Controls.Border
        $preview.Width = 28
        $preview.Height = 24
        $preview.BorderBrush = New-Brush "#FF000000"
        $preview.BorderThickness = [System.Windows.Thickness]::new(1)
        $preview.Background = New-Brush $temp[$CurrentKey]
        $preview.Margin = [System.Windows.Thickness]::new(6, 0, 0, 0)
        [System.Windows.Controls.DockPanel]::SetDock($preview, [System.Windows.Controls.Dock]::Right)

        $button = New-SettingsButton "Choose"
        $button.Width = 90
        $button.Margin = [System.Windows.Thickness]::new(0, 0, 6, 0)
        $button.Tag = @{ Mode = $Mode; CurrentKey = $CurrentKey; Preview = $preview }
        [System.Windows.Controls.DockPanel]::SetDock($button, [System.Windows.Controls.Dock]::Right)

        $labelBlock = New-Label $Label
        [void]$dock.Children.Add($preview)
        [void]$dock.Children.Add($button)
        [void]$dock.Children.Add($labelBlock)
        [void]$colorPreviews.Add(@{ Key = $CurrentKey; Preview = $preview })

        $button.Add_Click({
            $tagData = $this.Tag
            $selected = Select-Color $temp[$tagData.CurrentKey]
            if ($tagData.Mode -eq "Accent") {
                Apply-AccentToMap -Target $temp -AccentColor $selected
            }
            elseif ($tagData.Mode -eq "MainText") {
                Apply-MainTextColorToMap -Target $temp -TextColor $selected
            }
            else {
                $temp[$tagData.CurrentKey] = $selected
            }
            $tagData.Preview.Background = New-Brush $selected
            Apply-SettingsWindowVisuals
        })

        [void]$Parent.Children.Add($dock)
    }

    function Add-PathRow {
        param(
            [System.Windows.Controls.StackPanel]$Parent,
            [string]$Key,
            [string]$Label,
            [string]$Mode
        )

        $labelBlock = New-Object System.Windows.Controls.TextBlock
        $labelBlock.Text = $Label
        $labelBlock.Margin = [System.Windows.Thickness]::new(0, 8, 0, 4)
        [void]$Parent.Children.Add($labelBlock)

        $grid = New-Object System.Windows.Controls.Grid
        $col1 = New-Object System.Windows.Controls.ColumnDefinition
        $col1.Width = [System.Windows.GridLength]::new(1, [System.Windows.GridUnitType]::Star)
        [void]$grid.ColumnDefinitions.Add($col1)
        $col2 = New-Object System.Windows.Controls.ColumnDefinition
        $col2.Width = [System.Windows.GridLength]::new(95)
        [void]$grid.ColumnDefinitions.Add($col2)

        $box = New-SettingsTextBox ([string]$temp[$Key])
        $box.Margin = [System.Windows.Thickness]::new(0, 0, 8, 0)
        [System.Windows.Controls.Grid]::SetColumn($box, 0)
        [void]$grid.Children.Add($box)

        $browse = New-SettingsButton "Browse"
        $browse.Tag = @{ Box = $box; Mode = $Mode }
        [System.Windows.Controls.Grid]::SetColumn($browse, 1)
        [void]$grid.Children.Add($browse)

        $browse.Add_Click({
            $tagData = $this.Tag
            $targetBox = $tagData.Box
            $browseMode = [string]$tagData.Mode
            if ($browseMode -eq "Folder") {
                $targetBox.Text = Select-FolderPath $targetBox.Text
            }
            else {
                $targetBox.Text = Select-IconPath $targetBox.Text
            }
        })

        [void]$Parent.Children.Add($grid)
        return $box
    }

    function Set-SettingsTextForeground {
        param(
            [System.Windows.DependencyObject]$Root,
            [System.Windows.Media.Brush]$Brush
        )

        foreach ($child in [System.Windows.LogicalTreeHelper]::GetChildren($Root)) {
            if ($child -is [System.Windows.Controls.TextBlock]) { $child.Foreground = $Brush }
            elseif ($child -is [System.Windows.Controls.CheckBox]) { $child.Foreground = $Brush }
            elseif ($child -is [System.Windows.Controls.Expander]) { $child.Foreground = $Brush }
            elseif ($child -is [System.Windows.Controls.TextBox]) { $child.Foreground = $Brush }
            elseif ($child -is [System.Windows.Controls.ComboBox]) { $child.Foreground = $Brush }

            if ($child -is [System.Windows.DependencyObject]) {
                Set-SettingsTextForeground -Root $child -Brush $Brush
            }
        }
    }

    function Update-ThemePreview {
        if ($previewControls.Count -eq 0) { return }

        $previewControls.Root.Background = New-Brush $temp["WindowBackgroundColor"]
        $previewControls.Root.BorderBrush = New-Brush $temp["WindowBorderColor"]
        $previewControls.Title.Foreground = New-Brush $temp["TitleFontColor"]
        $previewControls.Subtitle.Foreground = New-Brush $temp["SubtitleFontColor"]
        $previewControls.ListHeader.Foreground = New-Brush $temp["SectionLabelFontColor"]
        $previewControls.ListBox.Background = New-Brush $temp["ListBackgroundColor"]
        $previewControls.TaskText.Foreground = New-Brush $temp["ListFontColor"]
        $previewControls.HoverRow.Background = New-Brush $temp["ListHoverColor"]
        $previewControls.HoverText.Foreground = New-Brush $temp["ListHoverTextColor"]
        $previewControls.InputBox.Background = New-Brush $temp["InputBackgroundColor"]
        $previewControls.InputText.Foreground = New-Brush $temp["InputFontColor"]
        $previewControls.SubmitButton.Background = New-Brush $temp["ButtonBackgroundColor"]
        $previewControls.SubmitButton.Foreground = New-Brush $temp["ButtonFontColor"]
        $previewControls.EditButton.Background = New-Brush $temp["EditButtonBackgroundColor"]
        $previewControls.EditButton.Foreground = New-Brush $temp["EditButtonFontColor"]
        $previewControls.DeleteButton.Background = New-Brush $temp["DeleteButtonBackgroundColor"]
        $previewControls.DeleteButton.Foreground = New-Brush $temp["DeleteButtonFontColor"]
        $previewControls.Status.Background = New-Brush $temp["StatusBackgroundColor"]
        $previewControls.StatusText.Foreground = New-Brush $temp["StatusTextColor"]
    }

    function Apply-SettingsWindowVisuals {
        $settingsWindow.Background = New-Brush $temp["WindowBackgroundColor"]
        $settingsPanel.Background = New-Brush $temp["WindowBackgroundColor"]

        $textBrush = New-Brush $temp["SettingsMenuTextColor"]
        Set-SettingsTextForeground -Root $settingsWindow -Brush $textBrush

        $boxColor = Darken-HexColor $temp["WindowBackgroundColor"] 10
        foreach ($box in $textBoxes) { $box.Background = New-Brush $boxColor }

        foreach ($combo in $comboBoxes) {
            $combo.Background = New-Brush $boxColor
            $combo.Foreground = New-Brush $temp["SettingsMenuTextColor"]
            $combo.BorderBrush = New-Brush $temp["WindowBorderColor"]
            $combo.FontWeight = [System.Windows.FontWeights]::SemiBold
            $combo.Resources[[System.Windows.SystemColors]::WindowBrushKey] = New-Brush $boxColor
            $combo.Resources[[System.Windows.SystemColors]::WindowTextBrushKey] = New-Brush $temp["SettingsMenuTextColor"]
            $combo.Resources[[System.Windows.SystemColors]::ControlBrushKey] = New-Brush $boxColor
            $combo.Resources[[System.Windows.SystemColors]::ControlTextBrushKey] = New-Brush $temp["SettingsMenuTextColor"]
            $combo.Resources[[System.Windows.SystemColors]::HighlightBrushKey] = New-Brush $temp["ButtonBackgroundColor"]
            $combo.Resources[[System.Windows.SystemColors]::HighlightTextBrushKey] = New-Brush $temp["ButtonFontColor"]
        }

        if ($null -ne $themeSelectorPopupBorder) {
            $themeSelectorPopupBorder.Background = New-Brush $temp["WindowBackgroundColor"]
            $themeSelectorPopupBorder.BorderBrush = New-Brush $temp["WindowBorderColor"]
        }

        foreach ($button in $settingsButtons) {
            $button.Foreground = New-Brush $temp["ButtonFontColor"]
            $button.Background = New-Brush $temp["ButtonBackgroundColor"]
            $button.BorderBrush = New-Brush "#FF000000"
            $button.BorderThickness = [System.Windows.Thickness]::new(1)
            $button.FontWeight = [System.Windows.FontWeights]::SemiBold
        }

        foreach ($entry in $colorPreviews) {
            $entry.Preview.Background = New-Brush $temp[$entry.Key]
        }

        Update-ThemePreview
    }

    function Reset-TempColors {
        foreach ($key in (Get-ThemeColorKeys)) { $temp[$key] = $script:DefaultSettings[$key] }
        Apply-SettingsWindowVisuals
    }

    function Reset-TempFonts {
        foreach ($key in (Get-ThemeFontKeys)) {
            $temp[$key] = $script:DefaultSettings[$key]
            if ($sizeBoxes.Contains($key)) { $sizeBoxes[$key].Text = [string]$temp[$key] }
        }
        Apply-SettingsWindowVisuals
    }

    function Reset-TempAppearance {
        foreach ($key in $script:AppearanceKeys) { $temp[$key] = $script:DefaultSettings[$key] }
        foreach ($entry in $sizeBoxes.GetEnumerator()) { $entry.Value.Text = [string]$temp[$entry.Key] }
        Apply-SettingsWindowVisuals
    }

    function Write-SettingsFromTemp {
        foreach ($key in @($temp.Keys)) { $script:S[$key] = $temp[$key] }
        foreach ($entry in $sizeBoxes.GetEnumerator()) {
            $key = $entry.Key
            $box = $entry.Value
            $script:S[$key] = Get-ClampedInt $box.Text $script:S[$key] 8 72
            $box.Text = [string]$script:S[$key]
        }
    }

    function RefreshCustomThemeCombo {
        param([System.Windows.Controls.ComboBox]$ComboBox)
        $ComboBox.Items.Clear()
        foreach ($name in @($script:CustomThemes.Keys | Sort-Object)) { [void]$ComboBox.Items.Add($name) }
        if ($ComboBox.Items.Count -gt 0) { $ComboBox.SelectedIndex = 0 }
    }

    # Appearance section
    $appearance = Add-Section "Appearance" $true

    $themeSelectorGrid = New-Object System.Windows.Controls.Grid
    $themeSelectorGrid.Margin = [System.Windows.Thickness]::new(0, 0, 0, 8)

    $themeSelectorButton = New-SettingsButton "Choose Theme"
    $themeSelectorButton.Height = 38
    $themeSelectorButton.HorizontalAlignment = "Stretch"
    $themeSelectorButton.ToolTip = "Open animated theme preset selector"
    [void]$themeSelectorGrid.Children.Add($themeSelectorButton)

    $themeSelectorPopup = New-Object System.Windows.Controls.Primitives.Popup
    $themeSelectorPopup.PlacementTarget = $themeSelectorButton
    $themeSelectorPopup.Placement = [System.Windows.Controls.Primitives.PlacementMode]::Bottom
    $themeSelectorPopup.AllowsTransparency = $true
    $themeSelectorPopup.StaysOpen = $false
    $themeSelectorPopup.PopupAnimation = [System.Windows.Controls.Primitives.PopupAnimation]::Slide

    $themeSelectorPopupBorder = New-Object System.Windows.Controls.Border
    $themeSelectorPopupBorder.Width = 245
    $themeSelectorPopupBorder.MaxHeight = 310
    $themeSelectorPopupBorder.BorderThickness = [System.Windows.Thickness]::new(1)
    $themeSelectorPopupBorder.CornerRadius = [System.Windows.CornerRadius]::new(12)
    $themeSelectorPopupBorder.Padding = [System.Windows.Thickness]::new(8)
    $themeSelectorPopupBorder.Margin = [System.Windows.Thickness]::new(0, 6, 0, 0)

    $themeSelectorScroll = New-Object System.Windows.Controls.ScrollViewer
    $themeSelectorScroll.VerticalScrollBarVisibility = [System.Windows.Controls.ScrollBarVisibility]::Auto
    $themeSelectorList = New-Object System.Windows.Controls.StackPanel
    $themeSelectorScroll.Content = $themeSelectorList
    $themeSelectorPopupBorder.Child = $themeSelectorScroll
    $themeSelectorPopup.Child = $themeSelectorPopupBorder
    [void]$themeSelectorGrid.Children.Add($themeSelectorPopup)

    function Add-ThemeSelectorOption {
        param(
            [string]$Name,
            [string]$Source
        )

        $themeOptionButton = New-SettingsButton $Name
        $themeOptionButton.Height = 34
        $themeOptionButton.HorizontalAlignment = "Stretch"
        $themeOptionButton.Margin = [System.Windows.Thickness]::new(0, 0, 0, 6)
        $themeOptionButton.Tag = @{ Name = $Name; Source = $Source }
        $themeOptionButton.Add_Click({
            $tagData = $this.Tag
            $themeName = [string]$tagData.Name
            $themeSource = [string]$tagData.Source

            if ($themeSource -eq "Custom") {
                if ($script:CustomThemes.Contains($themeName)) {
                    Apply-ThemeDataToMap -Target $temp -ThemeData $script:CustomThemes[$themeName]
                    $themeSelectorButton.Content = "Theme: $themeName"
                    Apply-SettingsWindowVisuals
                    Set-StatusMessage "Previewing custom theme: $themeName"
                }
            }
            else {
                Apply-BuiltInThemeByName $themeName
            }

            $themeSelectorPopup.IsOpen = $false
        })
        [void]$themeSelectorList.Children.Add($themeOptionButton)
    }

    function RefreshThemeSelectorMenu {
        $themeSelectorList.Children.Clear()

        foreach ($name in $builtInThemes.Keys) {
            Add-ThemeSelectorOption -Name $name -Source "BuiltIn"
        }

        if ($script:CustomThemes.Count -gt 0) {
            $separator = New-Object System.Windows.Controls.TextBlock
            $separator.Text = "Saved Custom Themes"
            $separator.FontWeight = [System.Windows.FontWeights]::SemiBold
            $separator.Margin = [System.Windows.Thickness]::new(4, 8, 0, 6)
            [void]$themeSelectorList.Children.Add($separator)

            foreach ($name in @($script:CustomThemes.Keys | Sort-Object)) {
                Add-ThemeSelectorOption -Name $name -Source "Custom"
            }
        }
    }

    RefreshThemeSelectorMenu

    $themeSelectorButton.Add_Click({
        RefreshThemeSelectorMenu
        Apply-SettingsWindowVisuals
        $themeSelectorPopup.PlacementTarget = $themeSelectorButton
        $themeSelectorPopup.IsOpen = -not $themeSelectorPopup.IsOpen
    })

    Add-TwoColumnRow $appearance "Theme preset" $themeSelectorGrid

    Add-ActionColorRow $appearance "Accent Color" "AccentColor" "Accent"
    Add-ColorRow $appearance "WindowBackgroundColor" "Main Background"
    Add-ActionColorRow $appearance "Main Text Color" "TitleFontColor" "MainText"
    Add-ColorRow $appearance "ButtonBackgroundColor" "Button Color"

    $resetGrid = New-Object System.Windows.Controls.Grid
    $resetGrid.Margin = [System.Windows.Thickness]::new(0, 8, 0, 10)
    foreach ($width in @("*", "*", "*")) {
        $col = New-Object System.Windows.Controls.ColumnDefinition
        $col.Width = [System.Windows.GridLength]::new(1, [System.Windows.GridUnitType]::Star)
        [void]$resetGrid.ColumnDefinitions.Add($col)
    }
    $resetColorsButton = New-SettingsButton "Reset Colors"
    $resetFontsButton = New-SettingsButton "Reset Fonts"
    $resetAllButton = New-SettingsButton "Reset All Appearance"
    [System.Windows.Controls.Grid]::SetColumn($resetColorsButton, 0)
    [System.Windows.Controls.Grid]::SetColumn($resetFontsButton, 1)
    [System.Windows.Controls.Grid]::SetColumn($resetAllButton, 2)
    [void]$resetGrid.Children.Add($resetColorsButton)
    [void]$resetGrid.Children.Add($resetFontsButton)
    [void]$resetGrid.Children.Add($resetAllButton)
    [void]$appearance.Children.Add($resetGrid)

    # Preview
    $previewLabel = New-Object System.Windows.Controls.TextBlock
    $previewLabel.Text = "Live preview"
    $previewLabel.FontWeight = [System.Windows.FontWeights]::SemiBold
    $previewLabel.Margin = [System.Windows.Thickness]::new(0, 6, 0, 6)
    [void]$appearance.Children.Add($previewLabel)

    $previewRoot = New-Object System.Windows.Controls.Border
    $previewRoot.BorderThickness = [System.Windows.Thickness]::new(1)
    $previewRoot.CornerRadius = [System.Windows.CornerRadius]::new(12)
    $previewRoot.Padding = [System.Windows.Thickness]::new(12)
    $previewRoot.Margin = [System.Windows.Thickness]::new(0, 0, 0, 4)
    $previewStack = New-Object System.Windows.Controls.StackPanel
    $previewRoot.Child = $previewStack

    $previewTitle = New-Object System.Windows.Controls.TextBlock
    $previewTitle.Text = "Today's Completed Tasks"
    $previewTitle.FontWeight = [System.Windows.FontWeights]::Bold
    $previewTitle.FontSize = 18
    $previewTitle.HorizontalAlignment = "Center"
    [void]$previewStack.Children.Add($previewTitle)

    $previewSubtitle = New-Object System.Windows.Controls.TextBlock
    $previewSubtitle.Text = "Track completed tasks for today."
    $previewSubtitle.Margin = [System.Windows.Thickness]::new(0, 2, 0, 10)
    $previewSubtitle.HorizontalAlignment = "Center"
    [void]$previewStack.Children.Add($previewSubtitle)

    $previewListHeader = New-Object System.Windows.Controls.TextBlock
    $previewListHeader.Text = "Completed Tasks (2)"
    $previewListHeader.FontWeight = [System.Windows.FontWeights]::SemiBold
    [void]$previewStack.Children.Add($previewListHeader)

    $previewListBox = New-Object System.Windows.Controls.Border
    $previewListBox.BorderThickness = [System.Windows.Thickness]::new(1)
    $previewListBox.BorderBrush = New-Brush "#FFCBD5E1"
    $previewListBox.CornerRadius = [System.Windows.CornerRadius]::new(10)
    $previewListBox.Padding = [System.Windows.Thickness]::new(8)
    $previewListBox.Margin = [System.Windows.Thickness]::new(0, 4, 0, 8)
    $previewListStack = New-Object System.Windows.Controls.StackPanel
    $previewListBox.Child = $previewListStack

    $previewTaskText = New-Object System.Windows.Controls.TextBlock
    $previewTaskText.Text = "• Example completed task"
    $previewTaskText.Margin = [System.Windows.Thickness]::new(0, 0, 0, 6)
