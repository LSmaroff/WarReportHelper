$ToggleButton.Add_Click({
    $script:S["ListVisible"] = -not [bool]$script:S["ListVisible"]
    Apply-ListVisibility
    Save-Config
})

$SubmitButton.Add_Click({
    Submit-Task
})

$TaskInput.Add_TextChanged({
    Update-Placeholder
})

$TaskInput.Add_PreviewKeyDown({
    param($sender, $e)

    $shiftDown = (
        [System.Windows.Input.Keyboard]::Modifiers -band
        [System.Windows.Input.ModifierKeys]::Shift
    ) -eq [System.Windows.Input.ModifierKeys]::Shift

    if ($e.Key -eq [System.Windows.Input.Key]::Return -and -not $shiftDown) {
        $e.Handled = $true
        Submit-Task
    }
})

$TaskList.AddHandler(
    [System.Windows.Controls.Button]::ClickEvent,
    [System.Windows.RoutedEventHandler]{
        param($sender, $e)

        $button = Get-ParentOfType $e.OriginalSource ([System.Windows.Controls.Button])

        if ($null -eq $button) {
            return
        }

        $container = Get-ParentOfType $button ([System.Windows.Controls.ListBoxItem])

        if ($null -eq $container) {
            return
        }

        $index = $TaskList.ItemContainerGenerator.IndexFromContainer($container)

        if ($index -lt 0 -or $index -ge $TaskList.Items.Count) {
            return
        }

        if ([string]$button.Tag -eq "DeleteTask") {
            $removedTask = [string]$TaskList.Items[$index]
            $TaskList.Items.RemoveAt($index)

            if ($script:IsViewingPreviousList) {
                Mark-DisplayedListDirty
            }

            Save-Config
            Update-TaskCount

            if ($script:IsViewingPreviousList) {
                Set-StatusMessage "Deleted task from previous list. Changes are not saved to that file yet."
            }
            else {
                Set-StatusMessage "Deleted task: $removedTask"
            }

            $e.Handled = $true
        }
        elseif ([string]$button.Tag -eq "EditTask") {
            $originalTask = [string]$TaskList.Items[$index]
            $editResult = Show-EditTaskWindow $originalTask

            if ($editResult.Saved) {
                $TaskList.Items[$index] = [string]$editResult.Text

                if ($script:IsViewingPreviousList) {
                    Mark-DisplayedListDirty
                }

                Save-Config
                Update-TaskCount

                if ($script:IsViewingPreviousList) {
                    Set-StatusMessage "Previous list task updated. Changes are not saved to that file yet."
                }
                else {
                    Set-StatusMessage "Task updated."
                }
            }
            else {
                Set-StatusMessage "Edit canceled."
            }

            $e.Handled = $true
        }
    }
)


$script:MainWindow.Add_PreviewMouseDown({
    param($sender, $e)

    if ($null -eq $TaskList -or $TaskList.SelectedIndex -lt 0) {
        return
    }

    $itemContainer = Get-ParentOfType $e.OriginalSource ([System.Windows.Controls.ListBoxItem])
    if ($null -eq $itemContainer) {
        $TaskList.SelectedIndex = -1
    }
})

# -----------------------------
# Auto Save Timer
# -----------------------------
$script:AutoSaveTimer = New-Object System.Windows.Threading.DispatcherTimer
$script:AutoSaveTimer.Add_Tick({
    Save-TaskList
    Save-Config
})

# -----------------------------
# Save When Closing
# -----------------------------
$script:MainWindow.Add_Closing({
    param($sender, $e)

    if (-not (Prompt-SavePreviousIfDirty)) {
        $e.Cancel = $true
        return
    }

    Save-TaskList
    Save-Config
})

$script:MainWindow.Add_SizeChanged({
    Update-DynamicListFontSizing
})

$script:MainWindow.Add_Loaded({
    Update-DynamicListFontSizing
    Start-DadJokeLoad
})

Apply-Settings
Update-DefaultStatus
Start-StartupUpdateCheck

[void]$script:MainWindow.ShowDialog()
