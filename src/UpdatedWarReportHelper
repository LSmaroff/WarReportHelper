function Parse-TaskListDateText {
    param([string]$FilePath)

    $fallback = ""
    try {
        if ($FilePath -match '(\d{2})-(\d{2})-(\d{4})_(\d{2})-(\d{2})') {
            $dt = [datetime]::ParseExact(
                "$($matches[1])-$($matches[2])-$($matches[3]) $($matches[4]):$($matches[5])",
                "MM-dd-yyyy HH:mm",
                [System.Globalization.CultureInfo]::InvariantCulture
            )
            $fallback = $dt.ToString("MMMM d, yyyy 'at' h:mm tt")
        }

        if (Test-Path $FilePath) {
            $lines = Get-Content -Path $FilePath -ErrorAction Stop
            foreach ($line in $lines) {
                if ($line -match '^\s*Saved:\s*(.+?)\s*$') {
                    $raw = $matches[1].Trim()
                    $formats = @(
                        "MM-dd-yyyy HH:mm",
                        "dd-MM-yyyy HH:mm",
                        "M-d-yyyy H:mm",
                        "M/d/yyyy H:mm",
                        "MM/dd/yyyy HH:mm"
                    )

                    foreach ($format in $formats) {
                        try {
                            $dt = [datetime]::ParseExact(
                                $raw,
                                $format,
                                [System.Globalization.CultureInfo]::InvariantCulture,
                                [System.Globalization.DateTimeStyles]::None
                            )
                            return $dt.ToString("MMMM d, yyyy 'at' h:mm tt")
                        }
                        catch {}
                    }

                    return $raw
                }
            }
        }
    }
    catch {}

    if (-not [string]::IsNullOrWhiteSpace($fallback)) {
        return $fallback
    }

    return (Split-Path -Leaf $FilePath)
}

function Get-OpenedListSavedLine {
    param([string]$FilePath)

    try {
        if (Test-Path $FilePath) {
            $lines = Get-Content -Path $FilePath -ErrorAction Stop
            foreach ($line in $lines) {
                if ($line -match '^\s*Saved:\s*(.+?)\s*$') {
                    return $line
                }
            }
        }
    }
    catch {}

    return "Saved: $(Get-Date -Format 'MM-dd-yyyy HH:mm')"
}

function Read-TaskListFile {
    param([string]$FilePath)

    $tasks = @()

    try {
        $lines = Get-Content -Path $FilePath -ErrorAction Stop
        $afterHeader = $false

        foreach ($line in $lines) {
            $trimmed = [string]$line
            $trimmed = $trimmed.Trim()

            if ([string]::IsNullOrWhiteSpace($trimmed)) {
                $afterHeader = $true
                continue
            }

            if ($trimmed -match '^(Today''s Completed Tasks|Todays Completed Tasks)$') {
                continue
            }

            if ($trimmed -match '^\s*Saved:') {
                $afterHeader = $true
                continue
            }

            if ($trimmed.StartsWith("•")) {
                $tasks += $trimmed
                continue
            }

            if ($afterHeader) {
                $tasks += (Normalize-TaskText $trimmed)
            }
        }
    }
    catch {
        throw
    }

    return @($tasks)
}

function Write-TaskListFile {
    param(
        [string]$FilePath,
        [string[]]$Tasks,
        [string]$SavedLine
    )

    if ([string]::IsNullOrWhiteSpace($SavedLine)) {
        $SavedLine = "Saved: $(Get-Date -Format 'MM-dd-yyyy HH:mm')"
    }

    $exportContent = @()
    $exportContent += "Today's Completed Tasks"
    $exportContent += $SavedLine
    $exportContent += ""
    $exportContent += @($Tasks)

    $exportContent | Set-Content -Path $FilePath -Encoding UTF8
}

function Load-TasksIntoList {
    param([string[]]$Tasks)

    $TaskList.Items.Clear()

    foreach ($task in @($Tasks)) {
        if (-not [string]::IsNullOrWhiteSpace($task)) {
            [void]$TaskList.Items.Add([string]$task)
        }
    }

    Update-TaskCount
}

function Update-DateDisplay {
    if ($script:IsViewingPreviousList) {
        if (-not [string]::IsNullOrWhiteSpace($script:OpenedListDateText)) {
            $SubtitleBlock.Text = "Viewing saved list from $($script:OpenedListDateText) | Today: $(Get-TodayFullDateText)"
        }
        else {
            $SubtitleBlock.Text = "Viewing a previously saved list | Today: $(Get-TodayFullDateText)"
        }
    }
    else {
        $SubtitleBlock.Text = "$(Get-TodayDateText)"
    }
}

function Update-ReturnButtonVisibility {
    if ($null -eq $ReturnTodayButton) {
        return
    }

    if ($script:IsViewingPreviousList) {
        $ReturnTodayButton.Visibility = [System.Windows.Visibility]::Visible
    }
    else {
        $ReturnTodayButton.Visibility = [System.Windows.Visibility]::Collapsed
    }
}

function Save-OpenedPreviousList {
    if (-not $script:IsViewingPreviousList -or [string]::IsNullOrWhiteSpace($script:OpenedListPath)) {
        return $true
    }

    try {
        Write-TaskListFile `
            -FilePath $script:OpenedListPath `
            -Tasks @(Get-CurrentTasks) `
            -SavedLine $script:OpenedListSavedLine

        $script:OpenedListDirty = $false
        Set-StatusMessage "Saved changes to: $(Split-Path -Leaf $script:OpenedListPath)"
        return $true
    }
    catch {
        Show-AppMessage `
            -Message "The previous task list could not be saved.`n$($_.Exception.Message)" `
            -Title "Save Previous List Error" `
            -Image ([System.Windows.MessageBoxImage]::Error)

        return $false
    }
}

function Prompt-SavePreviousIfDirty {
    if (-not $script:IsViewingPreviousList -or -not $script:OpenedListDirty) {
        return $true
    }

    $result = [System.Windows.MessageBox]::Show(
        "You made changes to the previous task list.`n`nDo you want to save those changes to the opened file?",
        "Save Previous List Changes?",
        [System.Windows.MessageBoxButton]::YesNoCancel,
        [System.Windows.MessageBoxImage]::Question
    )

    if ($result -eq [System.Windows.MessageBoxResult]::Cancel) {
        return $false
    }

    if ($result -eq [System.Windows.MessageBoxResult]::Yes) {
        return (Save-OpenedPreviousList)
    }

    return $true
}

function Return-ToCurrentDayTasks {
    if (-not (Prompt-SavePreviousIfDirty)) {
        return
    }

    $script:IsViewingPreviousList = $false
    $script:OpenedListPath = ""
    $script:OpenedListDateText = ""
    $script:OpenedListSavedLine = ""
    $script:OpenedListDirty = $false

    Load-TasksIntoList -Tasks @($script:CurrentDayTasksCache)
    $script:CurrentDayTasksCache = @()
    Update-DateDisplay
    Update-ReturnButtonVisibility
    Update-DefaultStatus
    Save-Config
}

function Open-PreviousTaskList {
    if ($script:IsViewingPreviousList) {
        if (-not (Prompt-SavePreviousIfDirty)) {
            return
        }
    }
    else {
        $script:CurrentDayTasksCache = @(Get-CurrentTasks)
        Save-Config
    }

    $dialog = New-Object Microsoft.Win32.OpenFileDialog
    $dialog.Title = "Open Previously Saved Task List"
    $dialog.Filter = "Text Files (*.txt)|*.txt|All Files (*.*)|*.*"

    $exportDirectory = Get-ExportDirectory
    if ($exportDirectory -and (Test-Path $exportDirectory)) {
        $dialog.InitialDirectory = $exportDirectory
    }
    else {
        $dialog.InitialDirectory = $script:ScriptDirectory
    }

    if ($dialog.ShowDialog() -ne $true) {
        Set-StatusMessage "Open previous list canceled."
        return
    }

    try {
        $tasks = @(Read-TaskListFile -FilePath $dialog.FileName)

        $script:IsViewingPreviousList = $true
        $script:OpenedListPath = $dialog.FileName
        $script:OpenedListDateText = Parse-TaskListDateText -FilePath $dialog.FileName
        $script:OpenedListSavedLine = Get-OpenedListSavedLine -FilePath $dialog.FileName
        $script:OpenedListDirty = $false

        Load-TasksIntoList -Tasks $tasks
        Update-DateDisplay
        Update-ReturnButtonVisibility
        Set-StatusMessage "Viewing previous list: $(Split-Path -Leaf $dialog.FileName)"
    }
    catch {
        Show-AppMessage `
            -Message "The selected task list could not be opened.`n$($_.Exception.Message)" `
            -Title "Open Previous List Error" `
            -Image ([System.Windows.MessageBoxImage]::Error)
    }
}

function Mark-DisplayedListDirty {
    if ($script:IsViewingPreviousList) {
        $script:OpenedListDirty = $true
    }
}

function Save-TaskList {
    param(
        [switch]$ShowMessage,
        [switch]$ChooseLocation
    )

    try {
        $timestamp = Get-Date -Format "MM-dd-yyyy_HH-mm"
        $fileName = "${timestamp}_WarDraft.txt"

        if ($ChooseLocation) {
            $selectedPath = Select-SaveFilePath -InitialDirectory (Get-ExportDirectory) -DefaultFileName $fileName

            if ([string]::IsNullOrWhiteSpace($selectedPath)) {
                Set-StatusMessage "Manual save canceled."
                return $null
            }

            $filePath = $selectedPath
        }
        else {
            $exportDirectory = Get-ExportDirectory
            $filePath = Join-Path $exportDirectory $fileName
        }

        if ($script:IsViewingPreviousList -and -not $ChooseLocation) {
            $tasks = @($script:CurrentDayTasksCache)
        }
        else {
            $tasks = @(Get-CurrentTasks)
        }

        $exportContent = @()
        $exportContent += "Today's Completed Tasks"
        $exportContent += "Saved: $(Get-Date -Format 'MM-dd-yyyy HH:mm')"
        $exportContent += ""
        $exportContent += $tasks

        $exportContent | Set-Content -Path $filePath -Encoding UTF8

        $script:LastSaveTime = Get-Date
        Save-Config
        Set-StatusMessage "Saved $($tasks.Count) task(s) at $($script:LastSaveTime.ToString('hh:mm tt'))."

        if ($ShowMessage) {
            Show-AppMessage `
                -Message "Task list saved to:`n$filePath" `
                -Title "Task List Saved" `
                -Image ([System.Windows.MessageBoxImage]::Information)
        }

        return $filePath
    }
    catch {
        if ($ShowMessage) {
            Show-AppMessage `
                -Message "The task list could not be saved." `
                -Title "Save Error" `
                -Image ([System.Windows.MessageBoxImage]::Error)
        }

        Set-StatusMessage "Save failed."
    }
}


function Get-WorkWeekMonday {
    param([datetime]$Date = (Get-Date))

    $dateOnly = $Date.Date
    $dayNumber = [int]$dateOnly.DayOfWeek

    if ($dayNumber -eq 0) {
        return $dateOnly.AddDays(-6)
    }

    return $dateOnly.AddDays(1 - $dayNumber)
}

function Get-WorkWeekFriday {
    param([datetime]$Monday)
    return $Monday.Date.AddDays(4)
}

function Get-WeekFolderName {
    param([datetime]$Monday)
    $friday = Get-WorkWeekFriday $Monday
    return "$($Monday.ToString('dd MMM')) - $($friday.ToString('dd MMM')) Lists"
}

function Get-WeekWarFileName {
    param([datetime]$Monday)
    $friday = Get-WorkWeekFriday $Monday
    return "Week-$($Monday.ToString('ddMMM'))-$($friday.ToString('ddMMM'))-WAR.txt"
}

function Get-UniqueFilePath {
    param([string]$Path)

    if (-not (Test-Path $Path)) {
        return $Path
    }

    $directory = Split-Path -Parent $Path
    $baseName = [System.IO.Path]::GetFileNameWithoutExtension($Path)
    $extension = [System.IO.Path]::GetExtension($Path)
    $counter = 1

    do {
        $candidate = Join-Path $directory ("{0}_{1}{2}" -f $baseName, $counter, $extension)
        $counter++
    } while (Test-Path $candidate)

    return $candidate
}

function Move-PreviousWeekFilesToArchive {
    param(
        [datetime]$WeekMonday,
        [string]$ArchiveFolder
    )

    try {
        $weekFriday = Get-WorkWeekFriday $WeekMonday
        $exportDirectory = Get-ExportDirectory

        if (-not (Test-Path $exportDirectory)) { return }
        if (-not (Test-Path $ArchiveFolder)) { [void](New-Item -ItemType Directory -Path $ArchiveFolder -Force) }

        $files = Get-ChildItem -Path $exportDirectory -File -Filter "*.txt" -ErrorAction SilentlyContinue

        foreach ($file in $files) {
            $fileDate = $null

            if ($file.Name -match '^(\d{2})-(\d{2})-(\d{4})_\d{2}-\d{2}_WarDraft\.txt$') {
                try {
                    $fileDate = [datetime]::ParseExact(
                        "$($matches[1])-$($matches[2])-$($matches[3])",
                        "MM-dd-yyyy",
                        [System.Globalization.CultureInfo]::InvariantCulture
                    )
                }
                catch {}
            }

            if ($null -ne $fileDate -and $fileDate.Date -ge $WeekMonday.Date -and $fileDate.Date -le $weekFriday.Date) {
                $destination = Get-UniqueFilePath (Join-Path $ArchiveFolder $file.Name)
                Move-Item -Path $file.FullName -Destination $destination -Force -ErrorAction SilentlyContinue
            }
        }
    }
    catch {}
}

function Initialize-WorkWeekTracking {
    try {
        $currentMonday = Get-WorkWeekMonday
        $currentKey = $currentMonday.ToString("yyyy-MM-dd")

        if ([string]::IsNullOrWhiteSpace($script:S["LastWorkWeekMonday"])) {
            $script:S["LastWorkWeekMonday"] = $currentKey
            return
        }

        if ($script:S["LastWorkWeekMonday"] -eq $currentKey) {
            return
        }

        try {
            $previousMonday = [datetime]::ParseExact(
                [string]$script:S["LastWorkWeekMonday"],
                "yyyy-MM-dd",
                [System.Globalization.CultureInfo]::InvariantCulture
            )
        }
        catch {
            $previousMonday = $currentMonday.AddDays(-7)
        }

        $exportDirectory = Get-ExportDirectory
        $archiveFolder = Join-Path $exportDirectory (Get-WeekFolderName $previousMonday)
        if (-not (Test-Path $archiveFolder)) {
            [void](New-Item -ItemType Directory -Path $archiveFolder -Force)
        }

        $weeklyFile = Join-Path $archiveFolder (Get-WeekWarFileName $previousMonday)
        $weeklyFile = Get-UniqueFilePath $weeklyFile

        if ($script:SavedTasks.Count -gt 0) {
            Write-TaskListFile `
                -FilePath $weeklyFile `
                -Tasks @($script:SavedTasks) `
                -SavedLine "Saved: $(Get-Date -Format 'MM-dd-yyyy HH:mm')"
        }

        Move-PreviousWeekFilesToArchive -WeekMonday $previousMonday -ArchiveFolder $archiveFolder

        $script:SavedTasks = @()
        $script:S["LastWorkWeekMonday"] = $currentKey
        Save-Config
    }
    catch {}
}

function Compare-VersionString {
    param(
        [string]$Left,
        [string]$Right
    )

    try {
        $leftVersion = [version]$Left
        $rightVersion = [version]$Right
        return $leftVersion.CompareTo($rightVersion)
    }
    catch {
        return [string]::Compare($Left, $Right, $true)
    }
}

function Get-GitHubLatestReleaseInfo {
    $owner = [string]$script:S["UpdateRepoOwner"]
    $repo = [string]$script:S["UpdateRepoName"]

    if ([string]::IsNullOrWhiteSpace($owner) -or [string]::IsNullOrWhiteSpace($repo)) {
        throw "GitHub update repository owner or name is blank."
    }

    try { [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.SecurityProtocolType]::Tls12 } catch {}

    $apiUrl = "https://api.github.com/repos/$owner/$repo/releases/latest"
    $headers = @{
        "Accept" = "application/vnd.github+json"
        "User-Agent" = "WarReportHelper/$script:AppVersion"
    }

    $release = Invoke-RestMethod -Uri $apiUrl -Headers $headers -Method Get -TimeoutSec 20

    $scriptAsset = $release.assets | Where-Object { $_.name -eq "WarReportHelper.ps1" } | Select-Object -First 1
    $jsonAsset = $release.assets | Where-Object { $_.name -eq "WarReportHelper_Version.json" } | Select-Object -First 1

    if ($null -eq $scriptAsset) {
        throw "The latest release does not include WarReportHelper.ps1."
    }

    $versionInfo = $null
    if ($null -ne $jsonAsset) {
        $versionInfo = Invoke-RestMethod -Uri $jsonAsset.browser_download_url -Headers @{ "User-Agent" = "WarReportHelper/$script:AppVersion" } -Method Get -TimeoutSec 20
    }

    $latestVersion = $release.tag_name -replace '^v', ''
    if ($null -ne $versionInfo -and $versionInfo.version) {
        $latestVersion = [string]$versionInfo.version
    }

    return [pscustomobject]@{
        Release = $release
        VersionInfo = $versionInfo
        LatestVersion = $latestVersion
        ScriptUrl = [string]$scriptAsset.browser_download_url
        ScriptAsset = $scriptAsset
        JsonAsset = $jsonAsset
    }
}

function Check-ForUpdates {
    param(
        [switch]$Interactive,
        [switch]$Silent
    )

    try {
        $info = Get-GitHubLatestReleaseInfo
        $comparison = Compare-VersionString $info.LatestVersion $script:AppVersion

        if ($comparison -gt 0) {
            $message = "Update available: v$($info.LatestVersion). Current version: v$script:AppVersion."
            Set-StatusMessage $message

            if ($Interactive) {
                $result = [System.Windows.MessageBox]::Show(
                    "$message`n`nDo you want to update now?",
                    "War Report Helper Update Available",
                    [System.Windows.MessageBoxButton]::YesNo,
                    [System.Windows.MessageBoxImage]::Question
                )

                if ($result -eq [System.Windows.MessageBoxResult]::Yes) {
                    Start-AppUpdate
                }
            }

            return $true
        }

        if ($Interactive) {
            Show-AppMessage -Message "You are already on the latest version: v$script:AppVersion" -Title "No Update Available" -Image ([System.Windows.MessageBoxImage]::Information)
        }
        elseif (-not $Silent) {
            Set-StatusMessage "No update available. Current version: v$script:AppVersion."
        }

        return $false
    }
    catch {
        if ($Interactive) {
            Show-AppMessage -Message "Unable to check for updates.`n$($_.Exception.Message)" -Title "Update Check Failed" -Image ([System.Windows.MessageBoxImage]::Warning)
        }
        elseif (-not $Silent) {
            Set-StatusMessage "Update check failed."
        }

        return $false
    }
}

function Start-AppUpdate {
    try {
        $info = Get-GitHubLatestReleaseInfo
        $comparison = Compare-VersionString $info.LatestVersion $script:AppVersion

        if ($comparison -le 0) {
            $result = [System.Windows.MessageBox]::Show(
                "The latest release appears to be v$($info.LatestVersion), and you are running v$script:AppVersion.`n`nDo you want to reinstall the latest release anyway?",
                "Reinstall Latest Release?",
                [System.Windows.MessageBoxButton]::YesNo,
                [System.Windows.MessageBoxImage]::Question
            )

            if ($result -ne [System.Windows.MessageBoxResult]::Yes) { return }
        }
        else {
            $notes = ""
            if ($null -ne $info.VersionInfo -and $info.VersionInfo.releaseNotes) {
                $notes = "`n`nRelease notes:`n" + (($info.VersionInfo.releaseNotes | ForEach-Object { "- $_" }) -join "`n")
            }

            $result = [System.Windows.MessageBox]::Show(
                "Install War Report Helper v$($info.LatestVersion)?$notes",
                "Install Update",
                [System.Windows.MessageBoxButton]::YesNo,
                [System.Windows.MessageBoxImage]::Question
            )

            if ($result -ne [System.Windows.MessageBoxResult]::Yes) { return }
        }

        $targetScript = $PSCommandPath
        if ([string]::IsNullOrWhiteSpace($targetScript)) {
            $targetScript = Join-Path $script:ScriptDirectory "WarReportHelper.ps1"
        }

        $tempFolder = Join-Path ([System.IO.Path]::GetTempPath()) "WarReportHelper_Update"
        if (-not (Test-Path $tempFolder)) { [void](New-Item -ItemType Directory -Path $tempFolder -Force) }

        $downloadPath = Join-Path $tempFolder "WarReportHelper_New.ps1"
        Invoke-WebRequest -Uri $info.ScriptUrl -OutFile $downloadPath -Headers @{ "User-Agent" = "WarReportHelper/$script:AppVersion" } -UseBasicParsing -TimeoutSec 60

        if ($null -ne $info.VersionInfo -and $info.VersionInfo.sha256) {
            $expectedHash = ([string]$info.VersionInfo.sha256).ToUpperInvariant()
            $actualHash = (Get-FileHash -Path $downloadPath -Algorithm SHA256).Hash.ToUpperInvariant()

            if ($expectedHash -ne $actualHash) {
                throw "The downloaded update failed SHA256 verification. Expected $expectedHash but got $actualHash."
            }
        }

        $backupFolder = Join-Path $script:ScriptDirectory "Backups"
        if (-not (Test-Path $backupFolder)) { [void](New-Item -ItemType Directory -Path $backupFolder -Force) }

        $applyScript = Join-Path $tempFolder "Apply_WarReportHelper_Update.ps1"
        $backupName = "WarReportHelper_Backup_$(Get-Date -Format 'MM-dd-yyyy_HH-mm-ss').ps1"
        $backupPath = Join-Path $backupFolder $backupName

        $applyContent = @"
Add-Type -AssemblyName System.Windows.Forms -ErrorAction SilentlyContinue
Start-Sleep -Seconds 2
try {
    Copy-Item -Path '$targetScript' -Destination '$backupPath' -Force -ErrorAction SilentlyContinue
    Copy-Item -Path '$downloadPath' -Destination '$targetScript' -Force -ErrorAction Stop
    Start-Process powershell.exe -WindowStyle Hidden -ArgumentList @('-NoProfile','-ExecutionPolicy','Bypass','-STA','-File','$targetScript')
}
catch {
    [System.Windows.Forms.MessageBox]::Show('The War Report Helper update failed: ' + `$_.Exception.Message, 'Update Failed') | Out-Null
}
"@

        $applyContent | Set-Content -Path $applyScript -Encoding UTF8

        Set-StatusMessage "Applying update to v$($info.LatestVersion)..."
        Start-Process powershell.exe -WindowStyle Hidden -ArgumentList @('-NoProfile','-ExecutionPolicy','Bypass','-File', $applyScript)
        $script:MainWindow.Close()
    }
    catch {
        Show-AppMessage -Message "The update could not be installed.`n$($_.Exception.Message)" -Title "Update Failed" -Image ([System.Windows.MessageBoxImage]::Error)
    }
}

function Start-StartupUpdateCheck {
    if (-not [bool]$script:S["CheckForUpdatesOnStartup"]) { return }

    try {
        $timer = [System.Windows.Threading.DispatcherTimer]::new()
        $timer.Interval = [TimeSpan]::FromSeconds(5)
        $timer.Add_Tick({
            $this.Stop()
            Check-ForUpdates -Silent | Out-Null
        })
        $timer.Start()
    }
    catch {}
}

