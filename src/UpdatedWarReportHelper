function New-ButtonImage {
    param(
        [string]$Path,
        [double]$MaxSize = 28
    )

    if (-not $Path -or -not (Test-Path $Path)) {
        return $null
    }

    try {
        $bitmap = New-Object System.Windows.Media.Imaging.BitmapImage
        $bitmap.BeginInit()
        $bitmap.CacheOption = [System.Windows.Media.Imaging.BitmapCacheOption]::OnLoad
        $bitmap.UriSource = [Uri]::new($Path)
        $bitmap.EndInit()
        $bitmap.Freeze()

        $pixelWidth = [double]$bitmap.PixelWidth
        $pixelHeight = [double]$bitmap.PixelHeight

        if ($pixelWidth -le 0) { $pixelWidth = 1 }
        if ($pixelHeight -le 0) { $pixelHeight = 1 }

        $ratio = $pixelWidth / $pixelHeight

        if ($ratio -ge 1) {
            $displayWidth = $MaxSize
            $displayHeight = $MaxSize / $ratio
        }
        else {
            $displayHeight = $MaxSize
            $displayWidth = $MaxSize * $ratio
        }

        $image = New-Object System.Windows.Controls.Image
        $image.Source = $bitmap
        $image.Width = $displayWidth
        $image.Height = $displayHeight
        $image.Stretch = [System.Windows.Media.Stretch]::Uniform
        $image.SnapsToDevicePixels = $true

        return $image
    }
    catch {
        return $null
    }
}


function Start-ButtonPressAnimation {
    param(
        [System.Windows.Controls.Button]$Button,
        [double]$Scale = 0.96
    )

    if ($null -eq $Button) { return }

    if ($null -eq $Button.RenderTransform -or -not ($Button.RenderTransform -is [System.Windows.Media.ScaleTransform])) {
        $Button.RenderTransformOrigin = [System.Windows.Point]::new(0.5, 0.5)
        $Button.RenderTransform = [System.Windows.Media.ScaleTransform]::new(1, 1)
    }

    $duration = [System.Windows.Duration]::new([TimeSpan]::FromMilliseconds(65))
    $ease = [System.Windows.Media.Animation.CubicEase]::new()
    $ease.EasingMode = [System.Windows.Media.Animation.EasingMode]::EaseOut

    $x = [System.Windows.Media.Animation.DoubleAnimation]::new()
    $x.To = $Scale
    $x.Duration = $duration
    $x.EasingFunction = $ease

    $y = [System.Windows.Media.Animation.DoubleAnimation]::new()
    $y.To = $Scale
    $y.Duration = $duration
    $y.EasingFunction = $ease

    $Button.RenderTransform.BeginAnimation([System.Windows.Media.ScaleTransform]::ScaleXProperty, $x)
    $Button.RenderTransform.BeginAnimation([System.Windows.Media.ScaleTransform]::ScaleYProperty, $y)
}

function Register-ButtonPressAnimation {
    param([System.Windows.Controls.Button]$Button)

    if ($null -eq $Button) { return }

    $key = [string]$Button.GetHashCode()
    if ($script:AnimatedButtons.ContainsKey($key)) { return }
    $script:AnimatedButtons[$key] = $true

    $Button.RenderTransformOrigin = [System.Windows.Point]::new(0.5, 0.5)
    if ($null -eq $Button.RenderTransform -or -not ($Button.RenderTransform -is [System.Windows.Media.ScaleTransform])) {
        $Button.RenderTransform = [System.Windows.Media.ScaleTransform]::new(1, 1)
    }

    $Button.Add_PreviewMouseDown({ Start-ButtonPressAnimation -Button $this -Scale 0.96 })
    $Button.Add_PreviewMouseUp({ Start-ButtonPressAnimation -Button $this -Scale 1.0 })
    $Button.Add_MouseLeave({ Start-ButtonPressAnimation -Button $this -Scale 1.0 })
}

function Set-WpfButtonStyle {
    param([System.Windows.Controls.Button]$Button)

    if ($null -eq $Button) {
        return
    }

    Register-ButtonPressAnimation $Button

    $Button.Foreground = New-Brush $script:S["ButtonFontColor"]
    $Button.Background = New-Brush $script:S["ButtonBackgroundColor"]
    $Button.BorderBrush = New-Brush "#FF000000"
    $Button.BorderThickness = [System.Windows.Thickness]::new(1)
