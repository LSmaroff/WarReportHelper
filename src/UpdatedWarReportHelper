function Submit-Task {
    $newTask = $TaskInput.Text.Trim()

    if ($newTask -ne "") {
        $newTask = $newTask -replace "(`r`n|`n|`r)+", " "

        if (-not $newTask.StartsWith("•")) {
            $newTask = "• $newTask"
        }

        [void]$TaskList.Items.Add($newTask)
        $TaskInput.Clear()

        if ($script:IsViewingPreviousList) {
            Mark-DisplayedListDirty
        }

        Save-Config
        Update-TaskCount
        Update-Placeholder

        if ($script:IsViewingPreviousList) {
            Set-StatusMessage "Task added to previous list. Changes are not saved to that file yet."
        }
        else {
            Set-StatusMessage "Task added. $($TaskList.Items.Count) task(s) completed today."
        }
    }
}

function Get-ParentOfType {
    param(
        [object]$Object,
        [type]$Type
    )

    $current = $Object

    while ($null -ne $current) {
        if ($Type.IsAssignableFrom($current.GetType())) {
            return $current
        }

        try {
            $current = [System.Windows.Media.VisualTreeHelper]::GetParent($current)
        }
        catch {
            return $null
        }
    }

    return $null
}

function Normalize-TaskText {
    param([string]$Text)

    $value = $Text.Trim() -replace "(`r`n|`n|`r)+", " "

    if ($value -ne "" -and -not $value.StartsWith("•")) {
        $value = "• $value"
    }

    return $value
}

